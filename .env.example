# Keep public deployments in demo mode. Opt in to Live only in a local or private environment.
INSIGHTPILOT_ENABLE_LIVE=false

# In Live mode the workbench uses visitor-provided keys in sessionStorage.
DEEPSEEK_MODEL=deepseek-flash

# Configure a shared, high-entropy secret before a multi-instance deployment.
# A shared one-time approval store is also required; this setting alone is not enough.
INSIGHTPILOT_APPROVAL_SECRET=

# Enable the legacy workspace only if you are studying Fragments locally.
# This also requires INSIGHTPILOT_ENABLE_LIVE=true.
ENABLE_FRAGMENTS_PLAYGROUND=false
